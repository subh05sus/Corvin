{
  "name": "corvin-server",
  "version": "0.0.1",
  "description": "Fastify-based backend API for Corvin - AI-powered debugging and development assistance",
  "prisma": {
    "seed": "tsnd --transpile-only prisma/seed.ts"
  },
  "main": "server.js",
  "scripts": {
    "dev": "tsnd --transpile-only --respawn --exit-child src/server.ts",
    "start": "NODE_ENV=DEVELOPMENT node build/src/server.js",
    "build": "swc src -d dist --source-maps --copy-files && mkdir -p dist/src/views && cp -r src/views/* dist/src/views/ 2>/dev/null || true",
    "build:tsc": "tsc && tsc-alias && mkdir -p build/src/views && cp -r src/views/* build/src/views/ && echo 'Build Completed Success'",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix"
  },
  "author": "Revise Networks",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/google": "^1.0.0",
    "@google/genai": "^1.0.0",
    "@fastify/autoload": "^6.0.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/view": "^10.0.1",
    "@fastify/websocket": "^11.2.0",
    "ai": "^4.0.0",
    "cls-rtracer": "^2.6.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "envalid": "^7.1.0",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qs": "^6.14.0",
    "redis": "^4.6.6",
    "ws": "^8.18.3",
    "zod": "^3.25.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.11",
    "@types/dotenv": "^8.2.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "eslint": "^8.38.0",
    "nodemon": "^2.0.9",
    "prettier": "^2.8.7",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.4.1",
    "typescript": "^5.9.2"
  }
}
