{
  "name": "corvin-demo",
  "version": "1.0.0",
  "description": "Demo project showcasing debugging scenarios for Corvin copilot across independent microservices",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test:contract-drift": "node test-scenarios/contract-drift.js",
    "test:missing-tax": "node test-scenarios/missing-tax.js",
    "test:payment-timeout": "node test-scenarios/payment-timeout.js",
    "test:all": "npm run test:contract-drift && npm run test:missing-tax && npm run test:payment-timeout"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "winston": "^3.11.0",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  },
  "author": "",
  "license": "ISC"
}
